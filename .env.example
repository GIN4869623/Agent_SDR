# Agent 结构化工作日志：默认写入项目 logs/agent_runs.jsonl
AGENT_TRACE_ENABLED=true
# AGENT_TRACE_PATH=/absolute/path/to/agent_runs.jsonl
# 最多保留最近多少次请求；超过后自动删除最旧记录
AGENT_TRACE_MAX_RECORDS=1000

# 百炼 DashScope API Key（用于云端 embedding 建本地向量索引）
BAILIAN_API_KEY=sk-xxxxxxxx
# [已废弃] 百炼托管 RAG 应用 ID，本地向量库方案不再使用，可留空
BAILIAN_APP_ID=xxxxxxxx
# embedding 模型（文档与查询必须使用同一模型）
BAILIAN_EMBEDDING_MODEL=text-embedding-v2

# Tone 回环可视化：1=尝试弹 Matplotlib(Tk) 窗口；0=仅射频收发（适合 SSH/无 DISPLAY）
